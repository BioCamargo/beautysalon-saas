# ===================================================================
# NEXI PRO SaaS - Variáveis de Ambiente de Exemplo (.env)
# Copie este arquivo para .env ou configure no seu ambiente de execução
# ===================================================================

# -------------------------------------------------------------------
# Banco de Dados Relacional (PostgreSQL)
# -------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/studio
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui

# -------------------------------------------------------------------
# Servidor Web & Porta
# -------------------------------------------------------------------
PORT=8081
THYMELEAF_CACHE=false

# -------------------------------------------------------------------
# Autenticação JWT (Para APIs REST e App Mobile)
# -------------------------------------------------------------------
JWT_SECRET=BeautySalonSuperSecretKeyForJwtAuthenticationTokenGeneration2026!
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# Assinaturas & Cobrança Recorrente SaaS (Asaas Gateway)
# Opcional para ambiente local (mantenha false para desativar)
# -------------------------------------------------------------------
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_ENABLED=false

# -------------------------------------------------------------------
# Mensageria Assíncrona (RabbitMQ)
# Opcional para ambiente local (mantenha false para desativar)
# -------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_ENABLED=false

# -------------------------------------------------------------------
# Observabilidade de Sessão & UX (OpenReplay)
# -------------------------------------------------------------------
OPENREPLAY_ENABLED=false
OPENREPLAY_PROJECT_KEY=
